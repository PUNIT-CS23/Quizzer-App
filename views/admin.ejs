                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon">
                        <i class="fas fa-star"></i>
                    </div>
                    <div class="stat-details">
                        <h3>Rating</h3>
                        <p><span class="counter" data-target="4.8">0</span>/5</p>
                        <span class="trend up"><i class="fas fa-arrow-up"></i> 0.2</span>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon">
                        <i class="fas fa-comment"></i>
                    </div>
                    <div class="stat-details">
                        <h3>Total Feedbacks</h3>
                        <p class="counter" data-target="8745">0</p>
                        <span class="trend up"><i class="fas fa-arrow-up"></i> 5.7%</span>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon">
                        <i class="fas fa-user-check"></i>
                    </div>
                    <div class="stat-details">
                        <h3>Active Users</h3>
                        <p class="counter" data-target="9324">0</p>
                        <span class="trend down"><i class="fas fa-arrow-down"></i> 2.1%</span>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon">
                        <i class="fas fa-dollar-sign"></i>
                    </div>
                    <div class="stat-details">
                        <h3>Total Income</h3>
                        <p>$<span class="counter" data-target="254789">0</span></p>
                        <span class="trend up"><i class="fas fa-arrow-up"></i> 15.2%</span>
                    </div>
                </div>
            </div>

            <!-- Charts Section -->
            <div class="charts-container">
                <div class="chart-card">
                    <div class="chart-header">
                        <h3>Income Overview</h3>
                        <div class="chart-period">
                            <button class="period-btn active" data-period="day" onclick="updateChartPeriod('income', 'day')">Daily</button>
                            <button class="period-btn" data-period="week" onclick="updateChartPeriod('income', 'week')">Weekly</button>
                        </div>
                    </div>
                    <canvas id="incomeChart"></canvas>
                </div>
                <div class="chart-card">
                    <div class="chart-header">
                        <h3>User Growth</h3>
                        <div class="chart-period">
                            <button class="period-btn active" data-period="day" onclick="updateChartPeriod('users', 'day')">Daily</button>
                            <button class="period-btn" data-period="week" onclick="updateChartPeriod('users', 'week')">Weekly</button>
                        </div>
                    </div>
                    <canvas id="usersChart"></canvas>
                </div>
            </div>

            <!-- Ads Management Section -->
<div class="recent-activity">
  <h3>Manage Ads</h3>

<!-- Form to Add New Ad -->
<form id="addAdForm">
  <input type="text" name="title" id="adTitle" placeholder="Ad Title" required>
  <input type="text" name="imageUrl" id="adImage" placeholder="Ad Image URL" required>
  <input type="text" name="contact" id="adContact" placeholder="Contact Info" required>
  <input type="text" name="socialLink" id="adSocialLink" placeholder="Social Link (optional)">
  <button type="submit">Add Ad</button>
</form>



  <!-- Display Existing Ads -->
  <table>
    <thead>
        <tr>
            <th>Title</th>
            <th>Image</th>
            <th>Contact</th> <!-- New Column -->
            <th>Actions</th>
        </tr>
    </thead>
    <tbody id="adsTable">
        <% ads.forEach(ad => { %>
            <tr>
                <td><%= ad.title %></td>
                <td><img src="<%= ad.imageUrl %>" width="100"></td>
                <td><%= ad.contact %></td> <!-- Display Contact -->
                <td>
                    <button onclick="deleteAd('<%= ad._id %>')">Delete</button>
                </td>
            </tr>
        <% }); %>
    </tbody>
</table>



            <!-- Recent Activity -->
            <div class="recent-activity">
                <h3>Recent Activity</h3>
                <div class="activity-list">
                    <div class="activity-item">
                        <div class="activity-icon"><i class="fas fa-user-plus"></i></div>
                        <div class="activity-details">
                            <p>New user registered</p>
                            <span>2 minutes ago</span>
                        </div>
                    </div>
                    <div class="activity-item">
                        <div class="activity-icon"><i class="fas fa-clipboard-check"></i></div>
                        <div class="activity-details">
                            <p>User completed test #4582</p>
                            <span>15 minutes ago</span>
                        </div>
                    </div>
                    <div class="activity-item">
                        <div class="activity-icon"><i class="fas fa-comment"></i></div>
                        <div class="activity-details">
                            <p>New feedback received</p>
                            <span>1 hour ago</span>
                        </div>
                    </div>
                    <div class="activity-item">
                        <div class="activity-icon"><i class="fas fa-dollar-sign"></i></div>
                        <div class="activity-details">
                            <p>Payment received: $199.99</p>
