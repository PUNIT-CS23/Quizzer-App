                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
      document.getElementById("addAdForm").addEventListener("submit", async function (e) {
        e.preventDefault();
        
        const title = document.getElementById("adTitle").value;
        const imageUrl = document.getElementById("adImage").value; // Changed from `image` to `imageUrl` for clarity
        const contact = document.getElementById("adContact").value;
        const socialLink = document.getElementById("adSocialLink").value; // Get social link
        
        const response = await fetch("/add-ad", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ title, imageUrl, contact, socialLink }),
        });
      
        const data = await response.json();
        alert(data.message);
        location.reload();
      });
      
  </script>
  
    <script>
        // Set current date
document.addEventListener('DOMContentLoaded', function() {
    const dateElement = document.getElementById('current-date');
    const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
    const today = new Date();
    dateElement.textContent = today.toLocaleDateString('en-US', options);
    
    // Initialize counters
    initCounters();
    
    // Initialize charts
    initCharts();
});

// Counter animation
function initCounters() {
    const counters = document.querySelectorAll('.counter');
    const speed = 200;
    
    counters.forEach(counter => {
        const target = parseFloat(counter.getAttribute('data-target'));
        const isDecimal = target % 1 !== 0;
        const increment = target / speed;
        
        let count = 0;
        const updateCount = () => {
            if (count < target) {
                count += increment;
                if (count > target) count = target;
                
                if (isDecimal) {
                    counter.innerText = count.toFixed(1);
                } else {
                    counter.innerText = Math.floor(count).toLocaleString();
                }
                
                setTimeout(updateCount, 1);
            } else {
                counter.innerText = isDecimal ? target.toFixed(1) : target.toLocaleString();
            }
        };
        
        updateCount();
    });
}

// Chart initialization
function initCharts() {
    // Income Chart
    const incomeCtx = document.getElementById('incomeChart').getContext('2d');
    const incomeData = {
        day: {
            labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
            data: [3500, 4200, 3800, 5100, 4800, 6200, 5400]
        },
        week: {
            labels: ['Week 1', 'Week 2', 'Week 3', 'Week 4'],
            data: [21000, 24500, 28000, 26000]
        }
    };
    
    window.incomeChart = new Chart(incomeCtx, {
        type: 'line',
        data: {
            labels: incomeData.day.labels,
            datasets: [{
                label: 'Income ($)',
                data: incomeData.day.data,
                backgroundColor: 'rgba(46, 204, 113, 0.2)',
                borderColor: '#2ecc71',
                borderWidth: 2,
                tension: 0.4,
                fill: true,
                pointBackgroundColor: '#2ecc71',
                pointBorderColor: '#fff',
                pointBorderWidth: 2,
                pointRadius: 5,
                pointHoverRadius: 7
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    display: false
                },
                tooltip: {
                    backgroundColor: '#333',
                    titleColor: '#fff',
                    bodyColor: '#fff',
                    titleFont: {
                        size: 14,
                        weight: 'bold'
                    },
                    bodyFont: {
                        size: 13
                    },
                    padding: 12,
                    displayColors: false,
                    callbacks: {
                        label: function(context) {
                            return `$${context.raw.toLocaleString()}`;
                        }
                    }
                }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    grid: {
                        color: 'rgba(0, 0, 0, 0.05)'
                    },
                    ticks: {
                        callback: function(value) {
                            return '$' + value.toLocaleString();
                        }
                    }
                },
                x: {
                    grid: {
                        display: false
                    }
                }
            }
        }
    });
    
    // Users Chart
    const usersCtx = document.getElementById('usersChart').getContext('2d');
    const usersData = {
        day: {
            labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
            data: [120, 145, 132, 158, 175, 192, 210]
        },
        week: {
            labels: ['Week 1', 'Week 2', 'Week 3', 'Week 4'],
            data: [850, 920, 1050, 1120]
        }
    };
    
    window.usersChart = new Chart(usersCtx, {
        type: 'line',
        data: {
            labels: usersData.day.labels,
            datasets: [{
                label: 'New Users',
                data: usersData.day.data,
                backgroundColor: 'rgba(46, 204, 113, 0.2)',
                borderColor: '#2ecc71',
                borderWidth: 2,
                tension: 0.4,
                fill: true,
                pointBackgroundColor: '#2ecc71',
                pointBorderColor: '#fff',
                pointBorderWidth: 2,
                pointRadius: 5,
                pointHoverRadius: 7
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    display: false
                },
                tooltip: {
                    backgroundColor: '#333',
                    titleColor: '#fff',
                    bodyColor: '#fff',
                    titleFont: {
                        size: 14,
                        weight: 'bold'
                    },
                    bodyFont: {
                        size: 13
                    },
                    padding: 12,
                    displayColors: false
                }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    grid: {
                        color: 'rgba(0, 0, 0, 0.05)'
                    }
                },
                x: {
                    grid: {
                        display: false
                    }
                }
            }
        }
    });
}

// Update chart period (day/week)
function updateChartPeriod(chartType, period) {
    // Update active button
    const buttons = document.querySelectorAll(`.chart-card:has(#${chartType}Chart) .period-btn`);
    buttons.forEach(btn => {
        btn.classList.remove('active');
        if (btn.getAttribute('data-period') === period) {
            btn.classList.add('active');
        }
    });
    
    // Update chart data
    if (chartType === 'income') {
        const incomeData = {
            day: {
                labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
                data: [3500, 4200, 3800, 5100, 4800, 6200, 5400]
            },
            week: {
                labels: ['Week 1', 'Week 2', 'Week 3', 'Week 4'],
                data: [21000, 24500, 28000, 26000]
            }
        };
        
        window.incomeChart.data.labels = incomeData[period].labels;
        window.incomeChart.data.datasets[0].data = incomeData[period].data;
        window.incomeChart.update();
    } else if (chartType === 'users') {
        const usersData = {
            day: {
                labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
                data: [120, 145, 132, 158, 175, 192, 210]
            },
            week: {
                labels: ['Week 1', 'Week 2', 'Week 3', 'Week 4'],
                data: [850, 920, 1050, 1120]
            }
        };
        
        window.usersChart.data.labels = usersData[period].labels;
        window.usersChart.data.datasets[0].data = usersData[period].data;
        window.usersChart.update();
    }
}
    </script>

    <script>
      async function deleteAd(id) {
        const confirmed = confirm("Are you sure you want to delete this ad?");
        if (!confirmed) return;
    
        try {
          const response = await fetch(`/delete-ad/${id}`, {
            method: "POST",
          });
    
          if (response.ok) {
            alert("Ad deleted successfully!");
            location.reload();
          } else {
            const error = await response.text();
            alert("Error deleting ad: " + error);
          }
        } catch (err) {
          console.error("Error:", err);
          alert("Something went wrong.");
        }
      }
    </script>
    

  
</body>
